---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  current?: string;
}
const {
  title,
  description = "Tyler J. Peckenpaugh — a generalist software engineer with a pull toward developer experience, DevOps, and infrastructure. Hobby projects, a blog, and a past life in theoretical linguistics.",
  current,
} = Astro.props;

const nav = [
  { href: "/#projects", label: "projects" },
  { href: "/blog/", label: "blog", key: "blog" },
  { href: "/#about", label: "about" },
];

// footer social marks — kept as inline SVG so they inherit currentColor and
// need no network request. All three are filled marks so they read as a set.
const social = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/tpeckenpaugh",
    path: "M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z",
    box: "0 0 448 512",
  },
  {
    label: "GitHub",
    href: "https://github.com/moui72",
    path: "M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z",
    box: "0 0 16 16",
  },
  {
    label: "Email",
    href: "mailto:peckenpaugh@gmail.com",
    path: "M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z",
    box: "0 0 24 24",
  },
];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="light dark" />
    <!-- set theme before paint to avoid flash -->
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        const sys = matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
        document.documentElement.dataset.theme = saved ?? sys;
      })();
    </script>
    <!-- GoatCounter: cookieless, privacy-friendly page analytics -->
    <script
      is:inline
      data-goatcounter="https://moui.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a href="/" class="monogram" aria-label="Tyler J. Peckenpaugh — home"
          >TJP</a
        >
        <nav class="nav" aria-label="Primary">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={current === item.key ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <button
            class="theme-toggle"
            id="theme-toggle"
            type="button"
            aria-label="Toggle color theme"
          >
            <span data-theme-label>◐</span>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Tyler J. Peckenpaugh</span>
        <ul class="social" aria-label="Elsewhere">
          {
            social.map((s) => (
              <li>
                <a href={s.href} aria-label={s.label}>
                  <svg viewBox={s.box} aria-hidden="true" focusable="false">
                    <path d={s.path} fill="currentColor" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
        <span>built with Astro</span>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.getElementById("theme-toggle");
        if (!btn) return;
        btn.addEventListener("click", () => {
          const next =
            document.documentElement.dataset.theme === "dark"
              ? "light"
              : "dark";
          document.documentElement.dataset.theme = next;
          localStorage.setItem("theme", next);
        });
      })();
    </script>
  </body>
</html>
