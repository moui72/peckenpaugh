---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = posts[0];

const projects = [
  {
    name: 'sync-tab-scroll',
    blurb:
      'Multiplayer guitar tab that scrolls in lockstep for a band playing in different rooms. One host drives a shared transport over WebSockets; everyone’s tab scrolls, plays, and counts in together. Live rendering via alphaTab.',
    stack: ['TypeScript', 'WebSockets', 'alphaTab'],
    repo: 'https://github.com/kinda-bad/sync-tab-scroll',
  },
  {
    name: 'assisted-review',
    blurb:
      'A CLI for reviewing pull requests. It pulls a GitHub PR or GitLab MR, splits the diff into readable chunks, and pages through it one chunk at a time with AI commentary alongside. Published to npm.',
    stack: ['TypeScript', 'React', 'CLI'],
    repo: 'https://github.com/moui72/assisted-review',
  },
  {
    name: 'artifact-driven-dev',
    blurb:
      'A spec-driven-development framework built on capturing decisions you’ve already made rather than eliciting them from scratch. Living artifacts, a versioned constitution, drift detection against the codebase. Written about below.',
    stack: ['Claude Code', 'skills', 'prose'],
    repo: 'https://github.com/moui72/artifact-driven-dev',
  },
];
---

<Base title="Tyler J. Peckenpaugh — software engineer">
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">software engineer · recovering theoretical linguistics</p>

      <div class="hero-head">
        <h1>Tyler J.<br />Peckenpaugh</h1>
        <!-- signature: an F0 pitch contour drawn over the utterance -->
        <svg
          class="contour"
          viewBox="0 0 1200 140"
          fill="none"
          aria-hidden="true"
          preserveAspectRatio="none"
        >
          <path
            class="contour-path"
            d="M0,96 C120,92 170,44 300,50 S520,104 640,82 S840,20 980,58 S1150,110 1200,96"
            stroke="var(--pitch)"
            stroke-width="2.5"
            stroke-linecap="round"
          />
          <circle class="contour-dot" r="5" fill="var(--pitch)" />
        </svg>
      </div>

      <p class="hero-sub prose">
        I build developer tools and the occasional web app. A few of them are below,
        along with a blog.
      </p>

      <div class="hero-actions">
        <a class="pill" href="#work">↓ see the work</a>
        {latest && <a class="pill" href="/blog/">✎ read the blog</a>}
      </div>
    </div>
  </section>

  <hr class="hr" />

  <!-- ============ WORK ============ -->
  <section id="work">
    <div class="wrap">
      <div class="section-tag">
        <span class="num">(1)</span>
        <h2>Work</h2>
      </div>

      <ol class="projects">
        {projects.map((p, i) => (
          <li class="project">
            <div class="project-num"><span>({i + 1})</span></div>
            <div class="project-body">
              <h3 class="project-name">
                <a href={p.repo}>{p.name}</a>
              </h3>
              <p class="project-blurb">{p.blurb}</p>
              <ul class="stack">
                {p.stack.map((s) => <li>{s}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <hr class="hr" />

  <!-- ============ ABOUT ============ -->
  <section id="about">
    <div class="wrap">
      <div class="section-tag">
        <span class="num">(2)</span>
        <h2>About</h2>
      </div>
      <div class="prose about">
        <p>
          I’m a software engineer. Most of what I build is developer tooling, with
          the occasional web app.
        </p>
        <p>
          Before software I did a PhD in theoretical linguistics. My dissertation
          was on garden-path sentences — the ones you parse down the wrong branch
          (<span class="gp">the horse raced past the barn <span class="gp-snag">fell</span></span>)
          before backing up to re-read.
        </p>
        <p class="now">
          <span class="eyebrow">now</span>
          TypeScript · Node · Claude Code tooling · a band that rehearses remotely
        </p>
      </div>
    </div>
  </section>

  {latest && (
    <>
      <hr class="hr" />
      <section id="blog-teaser">
        <div class="wrap">
          <div class="section-tag">
            <span class="num">(3)</span>
            <h2>Blog</h2>
          </div>
          <a class="teaser prose" href={`/blog/${latest.id}/`}>
            <p class="eyebrow">
              {latest.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
            </p>
            <h3>{latest.data.title}</h3>
            <p class="teaser-sub">{latest.data.description}</p>
            <span class="teaser-more">Read the essay →</span>
          </a>
        </div>
      </section>
    </>
  )}
</Base>

<style>
  .hero { padding-block: clamp(3.5rem, 9vw, 7rem) clamp(2.5rem, 6vw, 4rem); }
  .hero .eyebrow { margin-bottom: clamp(1.5rem, 4vw, 2.5rem); }

  .hero-head { position: relative; display: inline-block; }
  .hero-head h1 {
    font-size: var(--step-4);
    font-weight: 400;
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .contour {
    position: absolute;
    left: -2%;
    bottom: -0.35em;
    width: 104%;
    height: 3.2em;
    z-index: 0;
    overflow: visible;
    opacity: 0.85;
  }
  .contour-path {
    stroke-dasharray: 1600;
    stroke-dashoffset: 1600;
    animation: draw 1.7s cubic-bezier(0.22, 1, 0.36, 1) 0.35s forwards;
  }
  .contour-dot {
    offset-path: path('M0,96 C120,92 170,44 300,50 S520,104 640,82 S840,20 980,58 S1150,110 1200,96');
    offset-distance: 0%;
    opacity: 0;
    animation: travel 1.7s cubic-bezier(0.22, 1, 0.36, 1) 0.35s forwards;
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes travel {
    0% { offset-distance: 0%; opacity: 1; }
    92% { opacity: 1; }
    100% { offset-distance: 100%; opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .contour-path { stroke-dashoffset: 0; }
    .contour-dot { display: none; }
  }

  .hero-sub {
    font-size: var(--step-1);
    color: var(--ink-soft);
    margin-top: clamp(1.75rem, 5vw, 2.75rem);
    line-height: 1.5;
  }
  .hero-sub em { font-style: normal; color: var(--pitch); font-weight: 500; }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  /* ---- projects ---- */
  .projects { list-style: none; margin: 0; padding: 0; }
  .project {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 0 1rem;
    padding-block: clamp(1.6rem, 4vw, 2.4rem);
    border-top: 1px solid var(--rule);
  }
  .project:first-child { border-top: 0; }
  .project-num {
    font-family: var(--mono);
    color: var(--ink-faint);
    font-size: var(--step--1);
    padding-top: 0.55rem;
  }
  .project-name {
    font-size: var(--step-2);
    margin: 0 0 0.35em;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 0.9rem;
  }
  .project-name a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--pitch);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;
  }
  .project-name a::after {
    content: '↗';
    display: inline-block;
    margin-left: 0.28em;
    font-family: var(--mono);
    font-size: 0.6em;
    color: var(--pitch);
    vertical-align: 0.28em;
  }
  .project-name a:hover { color: var(--pitch); text-decoration-thickness: 3px; }
  .project-blurb { color: var(--ink-soft); max-width: var(--measure); margin-bottom: 0.9rem; }
  .stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin: 0;
    padding: 0;
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  .stack li::before { content: '· '; color: var(--rule); }
  .stack li:first-child::before { content: ''; }

  /* ---- about ---- */
  .about strong { font-weight: 600; }
  .gp { font-family: var(--mono); font-size: 0.86em; color: var(--ink-soft); }
  .gp-snag {
    color: var(--stress);
    border-bottom: 1.5px solid var(--stress);
    padding-bottom: 1px;
  }
  .about .now {
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.9rem;
  }
  .about .now .eyebrow { margin: 0; }

  /* ---- blog teaser ---- */
  .teaser { display: block; }
  .teaser:hover { text-decoration: none; }
  .teaser h3 {
    font-size: var(--step-2);
    color: var(--ink);
    margin: 0.3em 0 0.4em;
    text-decoration: underline;
    text-decoration-color: var(--pitch);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;
  }
  .teaser:hover h3 { color: var(--pitch); text-decoration-thickness: 3px; }
  .teaser-sub { color: var(--ink-soft); }
  .teaser-more { font-family: var(--mono); font-size: var(--step--1); color: var(--pitch); }

  @media (max-width: 34rem) {
    .project { grid-template-columns: 1fr; }
    .project-num { padding-top: 0; }
  }
</style>
