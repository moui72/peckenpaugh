---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = posts[0];

const projects = [
  {
    name: "sync-tab-scroll",
    blurb:
      "Multiplayer guitar tab that scrolls in lockstep for a band playing in different rooms. One host drives a shared transport over WebSockets; everyone's tab scrolls, plays, and counts in together. Live rendering via alphaTab.",
    stack: ["TypeScript", "WebSockets", "alphaTab", "Svelte"],
    repo: "https://github.com/kinda-bad/sync-tab-scroll",
  },
  {
    name: "assisted-review",
    blurb:
      "A CLI that makes you the reviewer and the AI the assistant. It pulls a GitHub PR or GitLab MR, splits the diff into readable chunks, and pages through them one at a time with AI commentary alongside. Published to npm.",
    stack: ["TypeScript", "React", "CLI", "AI"],
    repo: "https://github.com/moui72/assisted-review",
  },
  {
    name: "artifact-driven-dev",
    blurb:
      "A spec-driven-development framework built on capturing decisions you've already made rather than eliciting them from scratch. Living artifacts, a versioned constitution, drift detection against the codebase. I've written about it on the blog.",
    stack: ["Claude Code", "skills", "shell", "prose"],
    repo: "https://github.com/moui72/artifact-driven-dev",
  },
];
---

<Base title="Tyler J. Peckenpaugh — software engineer">
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="wrap hero-grid">
      <p class="eyebrow hero-kicker">
        software engineer · recovering theoretical linguistics
      </p>
      <div class="hero-lede">
        <div class="hero-head">
          <h1>Tyler J.<br />Peckenpaugh</h1>
          <!-- decorative flourish: a colour swoosh that spirals in and settles into an underline -->
          <svg
            class="swoosh"
            viewBox="0 0 400 24"
            fill="none"
            aria-hidden="true"
            preserveAspectRatio="none"
          >
            <defs>
              <linearGradient id="swooshGrad" x1="0" y1="0" x2="1" y2="0">
                <stop class="g0" offset="0"></stop>
                <stop class="g1" offset="1"></stop>
              </linearGradient>
            </defs>
            <path
              class="swoosh-path"
              d="M4,15 C70,3 140,21 210,11 S338,5 396,13"
              stroke="url(#swooshGrad)"
              stroke-width="3.5"
              stroke-linecap="round"></path>
          </svg>
        </div>

        <div class="hero-actions">
          <a class="pill" href="#work">↓ see the work</a>
          {
            latest && (
              <a class="pill" href="/blog/">
                ✎ read the blog
              </a>
            )
          }
        </div>
      </div>

      <aside class="hero-abstract">
        <p class="eyebrow">abstract</p>
        <p class="hero-sub">
          I&apos;m a generalist software engineer with a pull toward developer
          experience, DevOps, and infrastructure. Find some of my hobby projects
          below, and there&apos;s a blog, too.
        </p>
      </aside>
    </div>
  </section>

  <hr class="hr" />

  <!-- ============ WORK ============ -->
  <section id="work">
    <div class="wrap section-grid">
      <div class="section-head">
        <span class="num">(1)</span>
        <h2>Work</h2>
      </div>

      <ol class="projects section-body">
        {
          projects.map((p, i) => (
            <li class="project">
              <div class="project-num">
                <span>({String.fromCharCode(65 + i)})</span>
              </div>
              <div class="project-body">
                <h3 class="project-name">
                  <a href={p.repo}>{p.name}</a>
                </h3>
                <p class="project-blurb">{p.blurb}</p>
                <ul class="stack">
                  {p.stack.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <hr class="hr" />

  <!-- ============ ABOUT ============ -->
  <section id="about">
    <div class="wrap section-grid">
      <div class="section-head">
        <span class="num">(2)</span>
        <h2>About</h2>
      </div>
      <div class="prose about section-body">
        <p>
          I&apos;m a generalist software engineer, happiest writing, reading,
          testing, and deleting code. I lean toward developer experience and
          DevOps, with a good chunk of my work in infrastructure. These days I
          build products in health tech.
        </p>
        <p>
          Before software I did a PhD in linguistics at the CUNY Graduate
          Center, under Janet Dean Fodor. My dissertation was on whether the way
          people parse prepositional-phrase attachment ambiguities is affected
          by the prosody of spoken utterances.
        </p>
        <figure
          class="parse"
          id="parse"
          data-parse="misparse"
          aria-label="A garden-path sentence, parsed two ways"
        >
          <div class="parse-readout">
            <div class="parse-switch" role="group" aria-label="Choose a reading">
              <button
                type="button"
                class="ps-btn is-on"
                data-state="misparse"
                aria-pressed="true">first pass</button
              ><span class="ps-sep" aria-hidden="true">›</span
              ><button
                type="button"
                class="ps-btn"
                data-state="recovery"
                aria-pressed="false">reparse</button
              >
            </div>
            <div class="parse-stage">
              <svg class="parse-arcs" aria-hidden="true"></svg>
              <p class="parse-sentence">
                She planned to <span class="pw" id="pw-verb">cram</span> the{" "}
                <span class="pw" id="pw-noun">paperwork</span>{" "}
                <span class="pw" id="pw-amb">in the drawer</span>{" "}
                <span class="pw" id="pw-goal">into her briefcase</span>.
              </p>
            </div>
            <p class="parse-caption" id="parse-caption" aria-live="polite">
              <em class="c-blue">in the drawer</em> is read as the goal of
              <em class="c-blue">cram</em> — so
              <em class="c-red">into her briefcase</em> has nowhere to land.
            </p>
          </div>
          <figcaption class="parse-label">
            <span class="parse-num">Figure 1</span> — a prepositional phrase
            attachment ambiguity (garden path sentence)
          </figcaption>
        </figure>
        <p>
          If that makes no sense to you, you're leading a better life than me.
        </p>
        <p class="now">
          <span class="eyebrow">now</span>
          building in health tech, tending artifact-driven-dev, and playing in a
          band that&apos;s bad at keeping time
        </p>
      </div>
    </div>
  </section>

  {
    latest && (
      <>
        <hr class="hr" />
        <section id="blog-teaser">
          <div class="wrap section-grid">
            <div class="section-head">
              <span class="num">(3)</span>
              <h2>Blog</h2>
            </div>
            <a class="teaser prose section-body" href={`/blog/${latest.id}/`}>
              <p class="eyebrow">
                {latest.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                  timeZone: "UTC",
                })}
              </p>
              <h3>{latest.data.title}</h3>
              <p class="teaser-sub">{latest.data.description}</p>
              <span class="teaser-more">Read the post →</span>
            </a>
          </div>
        </section>
      </>
    )
  }
</Base>

<style>
  .hero {
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(2.5rem, 6vw, 4rem);
  }
  .hero-kicker {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  @media (min-width: 60rem) {
    .hero-kicker {
      grid-column: 1 / -1;
    }
  }

  /* masthead: title block left, abstract right — the empty right half now
     carries a paper-style abstract instead of dead space. */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 6vw, 3rem);
  }
  @media (min-width: 60rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.82fr);
      align-items: start;
      gap: clamp(2.5rem, 6vw, 5rem);
    }
  }

  .hero-abstract {
    border-left: 1px solid var(--rule);
    padding-left: clamp(1rem, 2vw, 1.6rem);
    align-self: end;
  }
  .hero-abstract .hero-sub {
    margin-top: 0.85rem;
    max-width: 42ch;
  }

  .hero-head {
    position: relative;
    display: inline-block;
  }
  .hero-head h1 {
    font-size: var(--step-4);
    font-weight: 400;
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .swoosh {
    position: absolute;
    left: 0;
    bottom: -0.06em;
    width: 100%;
    height: 0.55em;
    overflow: visible;
  }
  .swoosh .g0 {
    stop-color: var(--link);
  }
  .swoosh .g1 {
    stop-color: var(--hot);
  }
  .swoosh-path {
    stroke-dasharray: 470;
    stroke-dashoffset: 470;
    vector-effect: non-scaling-stroke;
    animation: swoosh-unroll 1.15s cubic-bezier(0.33, 0, 0.2, 1) 0.35s forwards;
  }
  @keyframes swoosh-unroll {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .swoosh-path {
      stroke-dashoffset: 0;
      animation: none;
    }
  }

  .hero-sub {
    font-size: var(--step-1);
    color: var(--ink-soft);
    margin-top: clamp(1.75rem, 5vw, 2.75rem);
    line-height: 1.5;
  }
  .hero-sub em {
    font-style: normal;
    color: var(--hot);
    font-weight: 500;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* section = margin rail (number + title) + body column.
     Stacks on narrow screens; becomes a two-column grid on wide ones,
     so the page keeps the hero's full-width composition instead of
     leaving the right half empty. */
  .section-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .section-body {
    min-width: 0;
  }
  @media (min-width: 60rem) {
    .section-grid {
      grid-template-columns: minmax(0, 14rem) minmax(0, var(--measure));
      gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }
    .section-grid .section-head {
      position: sticky;
      top: 5rem;
      flex-direction: column;
      align-items: start;
      gap: 0.4rem;
    }
  }

  /* ---- projects ---- */
  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .project {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 0 1rem;
    padding-block: clamp(1.6rem, 4vw, 2.4rem);
    border-top: 1px solid var(--rule);
  }
  .project:first-child {
    border-top: 0;
  }
  .project-num {
    font-family: var(--mono);
    color: var(--ink-faint);
    font-size: var(--step--1);
    padding-top: 0.55rem;
  }
  .project-name {
    font-size: var(--step-2);
    margin: 0 0 0.35em;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 0.9rem;
  }
  .project-name a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--link);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;
  }
  .project-name a::after {
    content: "↗";
    display: inline-block;
    margin-left: 0.28em;
    font-family: var(--mono);
    font-size: 0.6em;
    color: var(--link);
    vertical-align: 0.28em;
  }
  .project-name a:hover {
    color: var(--link);
    text-decoration-thickness: 3px;
  }
  .project-blurb {
    color: var(--ink-soft);
    max-width: var(--measure);
    margin-bottom: 0.9rem;
  }
  .stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin: 0;
    padding: 0;
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  .stack li::before {
    content: "· ";
    color: var(--rule);
  }
  .stack li:first-child::before {
    content: "";
  }

  /* ---- about ---- */
  .about strong {
    font-weight: 600;
  }
  /* ---- garden-path parse diagram ---- */
  /* set the whole figure apart from the running text, like a numbered
     example in a paper */
  .parse {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0;
  }
  /* a figure caption, sitting below the card */
  .parse-label {
    max-width: 34rem;
    font-family: var(--mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    line-height: 1.5;
    color: var(--ink-faint);
    margin: 0.75rem 0 0;
  }
  .parse-num {
    color: var(--hot);
    margin-right: 0.35em;
  }
  .parse-stage {
    position: relative;
    padding: 5.25rem 1rem 1.15rem; /* top headroom for the brackets + labels */
    overflow-x: auto;
    overflow-y: visible;
  }
  .parse-arcs {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }
  .parse-sentence {
    font-family: var(--mono);
    font-size: 0.9em;
    line-height: 1.4;
    color: var(--ink-soft);
    white-space: nowrap;
    margin: 0;
  }
  .pw {
    transition: color 0.3s ease;
  }
  /* Each attachment gets one color, so its two constituents read as a pair
     and the two attachments contrast: verb-attachment = blue,
     noun-attachment = pink, the stranded PP (the crash) = red. */
  .parse[data-parse="misparse"] #pw-verb,
  .parse[data-parse="misparse"] #pw-amb {
    color: var(--link);
  }
  .parse[data-parse="misparse"] #pw-goal {
    color: var(--stress);
  }
  .parse[data-parse="recovery"] #pw-noun,
  .parse[data-parse="recovery"] #pw-amb {
    color: var(--hot);
  }
  .parse[data-parse="recovery"] #pw-verb,
  .parse[data-parse="recovery"] #pw-goal {
    color: var(--link);
  }

  /* segmented control + caption */
  /* the reading picker + its gloss, bound into one tabbed card so the
     control and the explanation read as a single unit */
  .parse-readout {
    max-width: 34rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
    overflow: hidden;
  }
  .parse-switch {
    display: flex;
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: var(--step--1);
  }
  .ps-btn {
    flex: 1 1 0;
    background: none;
    border: 0;
    color: var(--ink-faint);
    padding: 0.5rem 0.95rem;
    cursor: pointer;
    letter-spacing: 0.04em;
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }
  /* angled chevron between the tabs: first pass › reparse (directionality) */
  .ps-sep {
    display: flex;
    align-items: center;
    padding: 0 0.5rem;
    font-size: 1.05rem;
    line-height: 1;
    color: var(--ink-faint);
    user-select: none;
  }
  .ps-btn.is-on {
    color: var(--paper);
    background: var(--ink);
  }
  .ps-btn:not(.is-on):hover {
    color: var(--ink);
    background: var(--paper-2);
  }
  /* horizontal divide between the sentence and its explanation */
  .parse-caption {
    margin: 0;
    padding: 0.85rem 1rem 0.95rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  /* progressive enhancement: no JS → static snag + a plain first-pass gloss
     (no tabs, no card chrome) */
  .parse:not([data-ready]) .parse-arcs,
  .parse:not([data-ready]) .parse-switch {
    display: none;
  }
  .parse:not([data-ready]) .parse-readout {
    border: 0;
    border-radius: 0;
  }
  .parse:not([data-ready]) .parse-stage {
    padding: 0;
  }
  .parse:not([data-ready]) .parse-caption {
    padding: 0;
    margin-top: 1rem;
    border-top: 0;
  }
  .parse:not([data-ready]) #pw-amb {
    color: var(--stress);
    border-bottom: 1.5px solid var(--stress);
    padding-bottom: 1px;
  }
  .about .now {
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.9rem;
  }
  .about .now .eyebrow {
    margin: 0;
  }

  /* ---- blog teaser ---- */
  .teaser {
    display: block;
  }
  .teaser:hover {
    text-decoration: none;
  }
  .teaser h3 {
    font-size: var(--step-2);
    color: var(--ink);
    margin: 0.3em 0 0.4em;
    text-decoration: underline;
    text-decoration-color: var(--link);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;
  }
  .teaser:hover h3 {
    color: var(--link);
    text-decoration-thickness: 3px;
  }
  .teaser-sub {
    color: var(--ink-soft);
  }
  .teaser-more {
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--link);
  }

  @media (max-width: 34rem) {
    .project {
      grid-template-columns: 1fr;
    }
    .project-num {
      padding-top: 0;
    }
    /* garden-path figure: on phones, break out of the page gutter into a
       full-width band (top/bottom rules only), dropping the card's side
       chrome so the sentence gets the whole viewport and needn't h-scroll */
    .parse {
      margin-inline: calc(-1 * var(--gutter));
    }
    .parse-readout {
      max-width: none;
      border-inline: 0;
      border-radius: 0;
      /* lift the band off the page since it has no side border */
      background: color-mix(in srgb, var(--paper) 66%, #fff);
    }
    :root[data-theme="dark"] .parse-readout {
      background: color-mix(in srgb, var(--paper-2) 82%, var(--ink));
    }
    .parse-stage,
    .parse-caption,
    .parse-label {
      padding-inline: 0.75rem;
    }
    .parse-label {
      max-width: none;
    }
  }
</style>

<!-- arcs/labels are created in JS, so they miss Astro's scoped selectors;
     these rules must be global to reach them. -->
<style is:global>
  .arc {
    fill: none;
    stroke-width: 1.6;
    transition: stroke 0.35s ease;
  }
  .arc-amb {
    stroke: var(--link); /* misparse: attaches high, to the verb (goal) */
  }
  .parse[data-parse="recovery"] .arc-amb {
    stroke: var(--hot); /* recovery: attaches low, to the noun (which) */
  }
  .arc-goal {
    stroke: var(--link);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .parse[data-parse="recovery"] .arc-goal {
    opacity: 1;
  }
  .arc-dangle {
    stroke: var(--stress);
    stroke-dasharray: 2 3; /* dashed = tentative, unresolved */
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .parse[data-parse="misparse"] .arc-dangle {
    opacity: 1;
  }
  .arc-label {
    font-family: var(--mono);
    font-size: 11px;
    text-anchor: middle;
  }
  /* caption keywords — set via JS, so styled globally; colored to match the
     brackets they describe */
  .parse-caption em {
    font-style: normal;
    font-family: var(--mono);
    color: var(--ink);
  }
  .parse-caption .c-blue {
    color: var(--link);
  }
  .parse-caption .c-pink {
    color: var(--hot);
  }
  .parse-caption .c-red {
    color: var(--stress);
  }
  .lbl-amb {
    fill: var(--link);
    transition: fill 0.35s ease;
  }
  .parse[data-parse="recovery"] .lbl-amb {
    fill: var(--hot);
  }
  .lbl-goal {
    fill: var(--link);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .parse[data-parse="recovery"] .lbl-goal {
    opacity: 1;
  }
  .lbl-dangle {
    fill: var(--stress);
    font-weight: 700;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .parse[data-parse="misparse"] .lbl-dangle {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .arc,
    .arc-goal,
    .arc-dangle,
    .lbl-amb,
    .lbl-goal,
    .lbl-dangle {
      transition: none;
    }
  }
</style>

<script>
  // Garden-path parse diagram: draw attachment arcs over the sentence and
  // let the reader swing the ambiguous PP between the two readings.
  const fig = document.getElementById("parse");
  if (fig) {
    const NS = "http://www.w3.org/2000/svg";
    const svg = fig.querySelector<SVGSVGElement>(".parse-arcs")!;
    const stage = fig.querySelector<HTMLElement>(".parse-stage")!;
    const sentence = fig.querySelector<HTMLElement>(".parse-sentence")!;
    const verb = document.getElementById("pw-verb")!;
    const noun = document.getElementById("pw-noun")!;
    const amb = document.getElementById("pw-amb")!;
    const goal = document.getElementById("pw-goal")!;
    const cap = document.getElementById("parse-caption")!;
    const btns = Array.from(fig.querySelectorAll<HTMLButtonElement>(".ps-btn"));
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const mk = (t: string) => document.createElementNS(NS, t);
    // misparse: the goal-slot is already taken, so this arc reaches up and
    // finds nothing — the point where the parse crashes.
    const arcDangle = mk("path");
    arcDangle.setAttribute("class", "arc arc-dangle");
    const lblDangle = mk("text");
    lblDangle.setAttribute("class", "arc-label lbl-dangle");
    lblDangle.textContent = "?";
    const arcGoal = mk("path");
    arcGoal.setAttribute("class", "arc arc-goal");
    const arcAmb = mk("path");
    arcAmb.setAttribute("class", "arc arc-amb");
    const lblGoal = mk("text");
    lblGoal.setAttribute("class", "arc-label lbl-goal");
    lblGoal.textContent = "goal";
    const lblAmb = mk("text");
    lblAmb.setAttribute("class", "arc-label lbl-amb");
    svg.append(arcDangle, arcGoal, arcAmb, lblDangle, lblGoal, lblAmb);

    const captions: Record<string, string> = {
      misparse:
        '<em class="c-blue">in the drawer</em> is read as the goal of <em class="c-blue">cram</em> — so <em class="c-red">into her briefcase</em> has nowhere to land.',
      recovery:
        '<em class="c-pink">in the drawer</em> tells you which <em class="c-pink">paperwork</em>; <em class="c-blue">into her briefcase</em> is the goal.',
    };

    // scale the one-line sentence down so it fits its column
    function fitFont() {
      sentence.style.fontSize = "";
      const cs = getComputedStyle(stage);
      const avail =
        stage.clientWidth -
        parseFloat(cs.paddingLeft) -
        parseFloat(cs.paddingRight);
      const w = sentence.scrollWidth;
      if (w > avail) {
        const base = parseFloat(getComputedStyle(sentence).fontSize);
        sentence.style.fontSize =
          Math.max(9.5, (base * avail) / w - 0.5) + "px";
      }
    }

    // center-top of a word, in stage-local coordinates
    function anchor(el: HTMLElement) {
      const s = stage.getBoundingClientRect();
      const r = el.getBoundingClientRect();
      return { x: r.left - s.left + r.width / 2, top: r.top - s.top };
    }
    // squared "staple": legs down to each word, a bar across the top, and a
    // short tick up to the label — constituency-bracket notation.
    const TICK = 6;
    function staple(x1: number, x2: number, yBase: number, barY: number) {
      const mid = (x1 + x2) / 2;
      return (
        `M ${x1} ${yBase} L ${x1} ${barY} L ${x2} ${barY} L ${x2} ${yBase}` +
        ` M ${mid} ${barY} L ${mid} ${barY - TICK}`
      );
    }

    let state = "misparse";
    type P = { x1: number; x2: number; yBase: number; barY: number };
    let cur: P | null = null;

    const L_INNER = 22; // bar height of the short (inner) bracket
    const L_OUTER = 44; // bar height of the long (outer) bracket

    function ambTarget(): P {
      const a = anchor(amb);
      const left = anchor(state === "misparse" ? verb : noun);
      const yBase = a.top - 2;
      return { x1: left.x, x2: a.x, yBase, barY: yBase - L_INNER };
    }
    function drawAmb(p: P) {
      arcAmb.setAttribute("d", staple(p.x1, p.x2, p.yBase, p.barY));
      lblAmb.setAttribute("x", String((p.x1 + p.x2) / 2));
      lblAmb.setAttribute("y", String(p.barY - TICK - 4));
    }
    function drawGoal() {
      const v = anchor(verb);
      const g = anchor(goal);
      const yBase = anchor(amb).top - 2;
      const barY = yBase - L_OUTER; // rides above the inner bracket
      arcGoal.setAttribute("d", staple(v.x, g.x, yBase, barY));
      lblGoal.setAttribute("x", String((v.x + g.x) / 2));
      lblGoal.setAttribute("y", String(barY - TICK - 4));
    }
    // the crash: a half-bracket off the briefcase whose far leg reaches up
    // and stops in open air — there's no constituent left to land on.
    function drawDangle() {
      const a = anchor(amb);
      const g = anchor(goal);
      const yBase = anchor(amb).top - 2;
      const barY = yBase - L_OUTER;
      const tipX = g.x - (g.x - a.x) * 0.55; // open end hangs left of briefcase
      arcDangle.setAttribute(
        "d",
        `M ${g.x} ${yBase} L ${g.x} ${barY} L ${tipX} ${barY} L ${tipX} ${barY + 7}`,
      );
      lblDangle.setAttribute("x", String(tipX));
      lblDangle.setAttribute("y", String(barY - 5));
    }

    function animateAmb(target: P, animate: boolean) {
      if (!cur || !animate || reduce) {
        cur = target;
        drawAmb(target);
        return;
      }
      const from = { ...cur };
      const t0 = performance.now();
      const dur = 480;
      const ease = (t: number) => 1 - Math.pow(1 - t, 3);
      function step(now: number) {
        const k = Math.min((now - t0) / dur, 1);
        const e = ease(k);
        const p: P = {
          x1: from.x1 + (target.x1 - from.x1) * e,
          x2: from.x2 + (target.x2 - from.x2) * e,
          yBase: from.yBase + (target.yBase - from.yBase) * e,
          barY: from.barY + (target.barY - from.barY) * e,
        };
        drawAmb(p);
        if (k < 1) requestAnimationFrame(step);
        else cur = target;
      }
      requestAnimationFrame(step);
    }

    function setState(s: string, animate = true) {
      state = s;
      fig.dataset.parse = s;
      lblAmb.textContent = s === "misparse" ? "goal" : "which";
      cap.innerHTML = captions[s];
      btns.forEach((b) => {
        const on = b.dataset.state === s;
        b.classList.toggle("is-on", on);
        b.setAttribute("aria-pressed", String(on));
      });
      drawGoal();
      drawDangle();
      animateAmb(ambTarget(), animate);
    }

    btns.forEach((b) =>
      b.addEventListener("click", () => setState(b.dataset.state!)),
    );

    function relayout() {
      fitFont();
      drawGoal();
      drawDangle();
      animateAmb(ambTarget(), false);
    }

    function init() {
      fig.dataset.ready = "";
      fitFont();
      setState("misparse", false);
      // Guard against a feedback loop: fitFont() changes the sentence height,
      // which the observer would see as a resize. Only relayout when the
      // column *width* actually changes.
      let lastW = stage.clientWidth;
      new ResizeObserver(() => {
        const w = stage.clientWidth;
        if (w === lastW) return;
        lastW = w;
        relayout();
      }).observe(stage);
      if (!reduce) {
        const io = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              io.disconnect();
              setTimeout(() => setState("recovery"), 2100);
            }
          },
          { threshold: 0.6 },
        );
        io.observe(fig);
      }
    }

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(init);
    } else {
      init();
    }
  }
</script>
