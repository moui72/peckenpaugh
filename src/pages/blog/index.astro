---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Blog — Tyler J. Peckenpaugh" current="blog">
  <section class="lede">
    <div class="wrap">
      <p class="eyebrow">Blog</p>
      <h1>Notes on building fast, and the guardrails.</h1>
    </div>
  </section>

  <hr class="hr" />

  <section>
    <div class="wrap">
      <ol class="post-list">
        {posts.map((post, i) => (
          <li class="post-row">
            <a href={`/blog/${post.id}/`}>
              <span class="post-idx">({i + 1})</span>
              <span class="post-main">
                <span class="post-title">{post.data.title}</span>
                <span class="post-desc">{post.data.description}</span>
              </span>
              <time class="post-date" datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' })}
              </time>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  .lede { padding-block: clamp(3rem, 8vw, 5rem) clamp(2rem, 5vw, 3rem); }
  .lede h1 { font-size: var(--step-3); max-width: 20ch; }

  .post-list { list-style: none; margin: 0; padding: 0; }
  .post-row { border-top: 1px solid var(--rule); }
  .post-row:first-child { border-top: 0; }
  .post-row a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: 0.5rem 1rem;
    align-items: baseline;
    padding-block: clamp(1.4rem, 3.5vw, 2rem);
    color: var(--ink);
  }
  .post-row a:hover { text-decoration: none; }
  .post-idx { font-family: var(--mono); font-size: var(--step--1); color: var(--ink-faint); }
  .post-title {
    display: block;
    width: fit-content;
    font-family: var(--display);
    font-size: var(--step-2);
    line-height: 1.1;
    margin-bottom: 0.3em;
    transition: color 0.15s ease;
    text-decoration: underline;
    text-decoration-color: var(--pitch);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;
  }
  .post-row a:hover .post-title { color: var(--pitch); text-decoration-thickness: 3px; }
  .post-desc { color: var(--ink-soft); max-width: var(--measure); }
  .post-date {
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
    white-space: nowrap;
  }
  @media (max-width: 34rem) {
    .post-row a { grid-template-columns: 1fr; }
    .post-idx, .post-date { display: none; }
  }
</style>
